{
  "name": "@highforthis/web",
  "packageManager": "pnpm@10.30.1",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@apollo/client": "4.1.6",
    "@highforthis/shared": "workspace:*",
    "@lexical/a11y": "0.53.0",
    "@lexical/clipboard": "0.53.0",
    "@lexical/code-core": "0.53.0",
    "@lexical/dragon": "0.53.0",
    "@lexical/extension": "0.53.0",
    "@lexical/history": "0.53.0",
    "@lexical/html": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@openobserve/browser-logs": "0.4.1",
    "@openobserve/browser-rum": "0.4.1",
    "@preact/signals-core": "1.14.5",
    "@simplewebauthn/browser": "13.3.0",
    "graphql": "16.13.0",
    "graphql-tag": "2.12.6",
    "html-escape": "2.0.0",
    "i18next": "25.8.13",
    "lexical": "0.53.0",
    "qs": "6.15.0",
    "remix": "3.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "pnpm --filter @highforthis/shared build && pnpm dev:service",
    "dev:service": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "build": "pnpm --filter @highforthis/shared build",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test --type server",
    "typecheck": "tsgo"
  }
}
