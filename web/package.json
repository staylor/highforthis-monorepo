{
  "name": "@highforthis/web",
  "packageManager": "pnpm@10.30.1",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@apollo/client": "4.1.6",
    "@highforthis/shared": "workspace:*",
    "@openobserve/browser-core": "0.4.1",
    "@openobserve/browser-logs": "0.4.1",
    "@openobserve/browser-rum": "0.4.1",
    "@openobserve/browser-rum-core": "0.4.1",
    "@openobserve/js-core": "0.4.1",
    "graphql": "16.13.0",
    "graphql-tag": "2.12.6",
    "html-escape": "2.0.0",
    "i18next": "25.8.13",
    "qs": "6.15.0",
    "remix": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "pnpm --filter @highforthis/shared build && pnpm dev:service",
    "dev:service": "pnpm css && (pnpm css:watch & NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts)",
    "hmr": "pnpm css && (pnpm css:watch & NODE_ENV=development node --env-file-if-exists=.env hmr.ts)",
    "build": "pnpm --filter @highforthis/shared build && pnpm build:service",
    "build:service": "pnpm css",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "css": "tailwindcss -i app/styles/main.css -o app/styles/public/main.css",
    "css:watch": "tailwindcss -i app/styles/main.css -o app/styles/public/main.css --watch=always",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsgo"
  }
}
