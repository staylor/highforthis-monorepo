# Local development settings. `pnpm bootstrap` copies this to graphql/.env if it doesn't exist.

# Homebrew's Postgres lets your macOS account connect without a password.
# bootstrap fills in your username.
DATABASE_URL="postgresql://your-macos-username@localhost:5432/highforthis"

# Everything below is optional in development: `pnpm dev` runs without them, and only
# the feature that needs a value fails, with a message naming it. Production requires
# TOKEN_SECRET, the GCS values and YOUTUBE_API_KEY.

# Signs login tokens; development uses a fixed default
# TOKEN_SECRET=

# Media uploads to Google Cloud Storage
# GCS_BUCKET=
# GCS_CLIENT_EMAIL=
# GCS_PRIVATE_KEY=

# Importing videos from YouTube (a background job that runs every 4 hours)
# YOUTUBE_API_KEY=

# Geocoding venue addresses, on the server only
# GOOGLE_MAPS_GEOLOCATION_API_KEY=
# Venue maps: a separate key that's public in the page, restricted to the Maps Static API and
# this site's referrers
# GOOGLE_MAPS_BROWSER_API_KEY=

# Venue listings from Ticketmaster
# TICKETMASTER_API_KEY=

# Album covers and artists' artwork from Apple Music: a MusicKit key, its team, and the .p8
# file's contents
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_PRIVATE_KEY=
