{
  "name": "@highforthis/graphql",
  "packageManager": "pnpm@10.30.1",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@apollo/server": "5.4.0",
    "@google-cloud/storage": "7.19.0",
    "@highforthis/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "7.4.1",
    "@simplewebauthn/server": "13.3.2",
    "bcryptjs": "^3.0.3",
    "cron": "4.4.0",
    "ffprobe": "1.1.2",
    "ffprobe-static": "3.1.0",
    "graphql": "16.13.0",
    "jsonwebtoken": "^9.0.3",
    "musicmetadata": "2.0.5",
    "remix": "3.3.0",
    "sharp": "0.34.5",
    "slugify": "1.6.6",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "esbuild": "0.27.3",
    "jsdom": "^28.1.0",
    "prisma": "7.4.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "scripts": {
    "dev": "pnpm --filter @highforthis/shared build && pnpm dev:service",
    "dev:service": "NODE_ENV=development NODE_OPTIONS='--disable-warning=DEP0040' tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "pnpm --filter @highforthis/shared build && pnpm build:service",
    "build:service": "prisma generate && rm -rf dist && esbuild src/index.ts --packages=external --bundle --splitting --platform=node --target=node24 --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "node --env-file-if-exists=.env node_modules/prisma/build/index.js db push",
    "db:studio": "prisma studio",
    "db:dump": "bash tools/database/dump",
    "db:refresh": "bash tools/database/refresh-production",
    "db:reset": "bash tools/database/reset",
    "db:setup": "bash tools/database/setup",
    "db:reset-admin-password": "tsx --env-file-if-exists=.env tools/database/reset-admin-password.ts",
    "db:e2e-admin": "tsx --env-file-if-exists=.env tools/database/e2e-admin.ts",
    "tools:script:dev": "tsx --env-file-if-exists=.env",
    "tools:script:prod": "tsx --env-file-if-exists=.env.production",
    "test": "vitest run",
    "typecheck": "tsgo"
  }
}
