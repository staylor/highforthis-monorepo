#!/bin/bash
# Drops the database and builds it again from the migrations and seed data.
set -euo pipefail

source "$(dirname "$0")/common"
require_server

database="$(database_name)"

echo "Dropping database $database..."
psql --dbname="$(maintenance_url)" --no-psqlrc --quiet --set=ON_ERROR_STOP=1 \
  --set=database="$database" <<'SQL'
DROP DATABASE IF EXISTS :"database" WITH (FORCE);
SQL

exec bash "$(dirname "$0")/setup"
