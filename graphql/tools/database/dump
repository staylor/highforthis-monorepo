#!/bin/bash
# Saves the local database's rows as the seed that db:setup and db:reset load.
set -euo pipefail

source "$(dirname "$0")/common"
require_server

DUMP_FILE="dump/highforthis-seed.dump"

echo "Dumping database $(database_name) to $DUMP_FILE..."
pg_dump --no-owner --no-privileges --data-only --format=custom \
  --dbname="$DATABASE_URL" --file="$DUMP_FILE"

echo "Done! Seed file updated: $DUMP_FILE"
