{
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "eslint.validate": ["graphql"],
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "files.associations": {
    "*.css": "tailwindcss",
    "*.json": "jsonc"
  }
}
