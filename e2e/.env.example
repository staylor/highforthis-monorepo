# The local admin user the end-to-end tests sign in as. `pnpm e2e:admin`, which `pnpm test:e2e`
# runs first, copies this file to e2e/.env, fills in a random password when it's empty, and
# creates the user or resets its password. The address must end in .test.
E2E_ADMIN_EMAIL=e2e-admin@highforthis.test
E2E_ADMIN_PASSWORD=

# The database the tests' GraphQL server uses (default: DATABASE_URL from graphql/.env). It must be
# on this machine.
# E2E_DATABASE_URL=
