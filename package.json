{
  "name": "highforthis-monorepo",
  "packageManager": "pnpm@10.30.1",
  "version": "1.0.0",
  "description": "GraphQL, Web, and Apps",
  "repository": "https://github.com/staylor/highforthis-monorepo",
  "author": "Scott Taylor <scott.c.taylor@mac.com>",
  "license": "private",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "type": "module",
  "devDependencies": {
    "@graphql-codegen/add": "8.0.0",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/fragment-matcher": "8.0.0",
    "@graphql-codegen/import-types-preset": "5.0.0",
    "@graphql-codegen/introspection": "7.0.0",
    "@graphql-codegen/schema-ast": "7.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@graphql-eslint/eslint-plugin": "4.4.2",
    "@lexical/eslint-plugin": "0.53.0",
    "@types/ffprobe": "1.1.8",
    "@types/ffprobe-static": "2.0.3",
    "@types/musicmetadata": "2.0.9",
    "@types/node": "25.9.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@wonderboymusic/oxc-config": "2.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-i18next": "6.1.5",
    "graphql": "16.15.0",
    "knip": "6.46.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap",
    "dev": "pnpm --filter @highforthis/shared build && pnpm --parallel --filter @highforthis/graphql --filter @highforthis/web dev:service",
    "codegen": "graphql-codegen && pnpm lint-fix && pnpm codegen:ios",
    "codegen:ios": "sh apple/scripts/generate-api.sh",
    "db:refresh": "pnpm --filter @highforthis/graphql db:refresh",
    "db:reset": "pnpm --filter @highforthis/graphql db:reset",
    "graphql:dev": "pnpm --filter @highforthis/graphql dev",
    "web:dev": "pnpm --filter @highforthis/web dev",
    "observability:dev": "pnpm observability:dev:docker",
    "observability:dev:docker": "bash observability/dev.sh docker",
    "observability:dev:podman": "bash observability/dev.sh podman",
    "build": "pnpm --filter @highforthis/shared build && pnpm --filter @highforthis/graphql build:service",
    "knip": "pnpm --filter @highforthis/shared build && knip",
    "lint": "oxlint --report-unused-disable-directives-severity=error && oxfmt --check && pnpm lint:graphql",
    "lint-fix": "oxlint --fix && oxfmt && pnpm lint:graphql --fix",
    "lint:graphql": "eslint --cache --cache-strategy content --cache-location ./node_modules/.cache/eslint --report-unused-disable-directives .",
    "test:graphql": "pnpm --filter @highforthis/graphql test",
    "test:web": "pnpm --filter @highforthis/web test",
    "test:browser": "NODE_ENV=test node web/node_modules/remix/dist/cli-entry.js test --type browser 'web/app/**/*.test.browser.{ts,tsx}'",
    "test:e2e": "pnpm --filter @highforthis/shared build && pnpm e2e:admin && pnpm --filter @highforthis/e2e e2e",
    "e2e:admin": "pnpm --filter @highforthis/graphql db:e2e-admin",
    "typecheck": "pnpm --filter @highforthis/shared build && pnpm -r typecheck"
  }
}
