{
  "workspaces": {
    ".": {
      "entry": [
        "oxfmt.config.ts",
        "oxlint.config.ts"
      ],
      "ignoreDependencies": [
        "@lexical/eslint-plugin",
        "eslint-plugin-i18next",
        "eslint-plugin-tailwindcss",
        "esbuild",
        "tsconfig-paths",
        "tsx"
      ]
    },
    "graphql": {
      "entry": [
        "tools/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tools/**/*.ts"
      ]
    },
    "shared": {
      "project": [
        "src/**/*.{ts,tsx,js}"
      ],
      "includeEntryExports": true,
      "ignore": [
        "src/types/graphql.ts"
      ]
    },
    "web": {
      "entry": [
        "app/actions/public/entry.ts",
        "app/**/*.test.{ts,tsx}",
        "app/**/*.test.browser.{ts,tsx}"
      ],
      "project": [
        "*.ts",
        "app/**/*.{ts,tsx}"
      ],
      "ignore": [
        "app/types/graphql.ts"
      ],
      "ignoreDependencies": [
        "@lexical/a11y",
        "@lexical/clipboard",
        "@lexical/dragon",
        "@lexical/extension",
        "@lexical/html",
        "@preact/signals-core"
      ]
    },
    "e2e": {
      "entry": [
        "tests/*.setup.ts"
      ]
    }
  }
}
