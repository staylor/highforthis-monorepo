{
  "workspaces": {
    ".": {
      "entry": [
        "oxfmt.config.ts",
        "oxlint.config.ts"
      ],
      "ignoreDependencies": [
        "@lexical/eslint-plugin",
        "eslint-plugin-i18next",
        "eslint-plugin-tailwindcss",
        "esbuild",
        "react",
        "react-dom",
        "tsconfig-paths",
        "tsx"
      ]
    },
    "graphql": {
      "entry": [
        "tools/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tools/**/*.ts"
      ]
    },
    "shared": {
      "entry": [
        "src/logger.ts",
        "src/observability.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,js}"
      ]
    },
    "web": {
      "project": [
        "app.js",
        "src/**/*.{ts,tsx}"
      ]
    },
    "admin": {
      "project": [
        "app.js",
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ],
      "ignoreUnresolved": [
        "./build/server/index.js"
      ]
    }
  }
}
