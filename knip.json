{
  "workspaces": {
    ".": {
      "entry": [
        "oxfmt.config.ts",
        "oxlint.config.ts"
      ],
      "ignoreDependencies": [
        "@lexical/eslint-plugin",
        "eslint-plugin-i18next",
        "eslint-plugin-tailwindcss",
        "esbuild",
        "react",
        "react-dom",
        "tsconfig-paths",
        "tsx"
      ]
    },
    "graphql": {
      "entry": [
        "tools/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tools/**/*.ts"
      ]
    },
    "shared": {
      "entry": [
        "src/logger.ts",
        "src/observability.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,js}"
      ]
    },
    "web": {
      "entry": [
        "app/actions/public/entry.ts",
        "app/**/*.test.{ts,tsx}"
      ],
      "project": [
        "*.ts",
        "app/**/*.{ts,tsx}"
      ],
      "ignore": [
        "app/types/graphql.ts"
      ],
      "ignoreDependencies": [
        "@openobserve/browser-core",
        "@openobserve/browser-rum-core",
        "@openobserve/js-core"
      ]
    },
    "admin": {
      "project": [
        "app.js",
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ],
      "ignore": [
        "src/types/graphql.ts"
      ]
    }
  }
}
