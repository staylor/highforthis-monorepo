{
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "esbuild",
        "tsconfig-paths",
        "tsx"
      ]
    },
    "graphql": {
      "entry": [
        "tools/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tools/**/*.ts"
      ]
    },
    "shared": {
      "project": [
        "src/**/*.ts"
      ],
      "includeEntryExports": true
    },
    "web": {
      "entry": [
        "app/actions/public/entry.ts",
        "app/**/*.test.{ts,tsx}",
        "app/**/*.test.browser.{ts,tsx}"
      ],
      "project": [
        "*.ts",
        "app/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@lexical/a11y",
        "@lexical/clipboard",
        "@lexical/dragon",
        "@lexical/extension",
        "@lexical/html",
        "@preact/signals-core"
      ]
    },
    "e2e": {
      "entry": [
        "tests/*.setup.ts"
      ]
    }
  }
}
